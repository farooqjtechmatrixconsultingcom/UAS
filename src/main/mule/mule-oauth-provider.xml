		<oauth2-provider:create-client doc:name="Create client" doc:id="8c9073fb-7a76-4dcb-9cb3-32c3bbc32b4a" config-ref="OAuth2_Provider_Config" clientId="#[attributes.headers.client_Id]" secret="#[attributes.headers.client_secret]" clientName="#[attributes.headers.client_name]" authorizedGrantTypes='#[["CLIENT_CREDENTIALS"]]' type="CONFIDENTIAL" failIfPresent="true" description='#[""]' principal='#[""]' redirectUris='#[["abc.com"]]'/>
		<set-payload value='#["Client Created."]' doc:name="Set Payload" doc:id="bd368ff7-76e8-4c0e-a768-66501aada383" />
	</flow>
	<flow name="mule-oauth-providerFlow1" doc:id="bed1d08e-196c-41e5-81ed-7657d76f5730" >
		<http:listener doc:name="Listener" doc:id="16151f1e-c217-4a55-a2c3-0913bfcd1ebe" config-ref="HTTP_Listener_config" path="/validate"/>
		<oauth2-provider:validate-token doc:name="Validate token" doc:id="19e10e28-13f0-4328-a474-afefe6b6d898" config-ref="OAuth2_Provider_Config"/>
		<ee:transform doc:name="Transform Message" doc:id="660dc0d2-1bef-455a-81fc-985b23431aa0" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
